[TEMPLATE]
# ============================================================
#  NexusAI - Environment Template
#
#  Copy this file to `.env` and fill in your own keys:
#     Copy-Item .env.example .env
#
#  `.env` is already in .gitignore - never commit real keys.
#  Run the app with:  .\run-dev.ps1   (it loads .env for you)
# ============================================================

# ---------- Server ----------
NEXUS_PORT=8080
NEXUS_DATA_DIR=./data
NEXUS_SKILLS_DIR=./skills

# rolebased | concurrent | sequential
NEXUS_MODE=rolebased

# ============================================================
# PROVIDER: OpenRouter (RECOMMENDED)
# One key gives access to every model, including free ones.
# Free models:  deepseek/deepseek-chat:free, meta-llama/llama-3.3-70b:free
# Reasoning:    deepseek/deepseek-r1:free
# ============================================================
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-REPLACE_ME
NEXUS_MODEL=deepseek/deepseek-chat:free

# ============================================================
# PROVIDER: Google Gemini (swap the 3 lines above for these)
# ============================================================
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=AIza-REPLACE_ME
# NEXUS_MODEL=gemini-2.5-flash

# ============================================================
# PROVIDER: NineRouter / any custom OpenAI-compatible host
# ============================================================
# OPENAI_BASE_URL=https://YOUR-HOST/api/v1
# OPENAI_API_KEY=sk-REPLACE_ME
# NEXUS_MODEL=your-model-id

# ============================================================
# LLM RESILIENCE GUARD (STATUS.md priority 3 + PROJECT_VISION §13/§26)
#   NEXUS_LLM_MAX_CONCURRENT : max in-flight requests to the provider.
#       Extra requests queue instead of hammering local NineRouter
#       (prevents 503/timeout from 5 parallel heavy calls). Default 2.
#   NEXUS_LLM_MAX_ATTEMPTS   : total tries per request on transient
#       errors (network, 429, 5xx) with exponential backoff. Default 3.
#   NEXUS_MAX_TOTAL_TOKENS   : session token budget. Warns at 80%,
#       blocks further LLM calls at 100%. 0 = unlimited (default).
# ============================================================
NEXUS_LLM_MAX_CONCURRENT=2
NEXUS_LLM_MAX_ATTEMPTS=3
NEXUS_MAX_TOTAL_TOKENS=0

# ============================================================
# IMPORTANT
# The daemon uses ONE provider for all five agents. Per-agent
# model routing is not implemented yet (see Milestone 3 in
# AI_GUIDE.md). To switch provider, comment out the active
# block and uncomment the one you want.
# ============================================================
